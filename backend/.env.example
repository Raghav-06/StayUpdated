PORT=5000

# ─── LLM (required) ─────────────────────────────────────────────────────────────
# Any provider with an OpenAI-compatible API. Set its key, base URL and model name.
#   Provider     LLM_BASE_URL                                              LLM_MODEL (example)
#   OpenAI       https://api.openai.com/v1                                 gpt-4o-mini
#   Mistral      https://api.mistral.ai/v1                                 mistral-small-latest
#   Groq         https://api.groq.com/openai/v1                            llama-3.3-70b-versatile
#   OpenRouter   https://openrouter.ai/api/v1                              meta-llama/llama-3.3-70b-instruct
#   Gemini       https://generativelanguage.googleapis.com/v1beta/openai/  gemini-2.5-flash
#   Anthropic    https://api.anthropic.com/v1/                             claude-sonnet-5-5
#   HuggingFace  https://router.huggingface.co/v1                          meta-llama/Llama-3.1-8B-Instruct
#   Ollama       http://localhost:11434/v1   (key can be any text)         llama3.2
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# How long one AI request (chat or embeddings) may take before it fails, in ms. Retried once.
LLM_TIMEOUT_MS=60000

# ─── Embeddings (optional) ──────────────────────────────────────────────────────
# The news search uses them to check each article is about the topic and to drop duplicates.
# Leave EMBEDDING_MODEL empty to use local keyword matching instead (works with any provider).
# The key and URL default to the LLM ones; set them only if embeddings come from another provider.
#   OpenAI: text-embedding-3-small   Mistral: mistral-embed   Gemini: text-embedding-004
#   Ollama: nomic-embed-text
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Set to "huggingface" to use HF's native feature-extraction API (e.g. BAAI/bge-small-en-v1.5).
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
NEWS_MIN_RELEVANCE=0.35
# Reuse an identical search (same topic and options) made in the last N minutes, by anyone. 0 disables.
NEWS_CACHE_MINUTES=15

# ─── Database (required for sign-in and history) ────────────────────────────────
DATABASE_URL=postgres://postgres:password@localhost:5432/stayupdated
DATABASE_SSL=false

# ─── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
# This API's public URL, used for links that point at the backend (the digest's unsubscribe link).
BACKEND_URL=http://localhost:5000
# Google sign-in ("Continue with Google"). To get these:
#   1. https://console.cloud.google.com/apis/credentials -> Create credentials -> OAuth client ID
#      (configure the OAuth consent screen first if asked; scopes: openid, email, profile)
#   2. Application type: Web application
#   3. Authorized JavaScript origins: http://localhost:5173 (and your production frontend URL)
#   4. Authorized redirect URIs: exactly GOOGLE_REDIRECT_URI below (and the production one)
#   5. While the consent screen is in "Testing", add your Google account under Test users
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ─── Email (optional) ───────────────────────────────────────────────────────────
# Without SMTP_HOST, verification codes are printed to the backend console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=StayUpdated <no-reply@example.com>

# ─── City agent tools (optional) ────────────────────────────────────────────────
TAVILY_API_KEY=
OPENWEATHER_API_KEY=

# ─── Extra news sources (optional; each is skipped until its keys are set) ──────
SERPER_API_KEY=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
BSKY_HANDLE=
BSKY_APP_PASSWORD=
MASTODON_INSTANCE=https://mastodon.social

# ─── Daily digest (emails new sources on followed topics) ───────────────────────
# Set to false to turn the scheduled digest off ("Send me my digest now" still works).
DIGEST_ENABLED=true
# When to send it (cron syntax: minute hour day month weekday) and in which time zone.
DIGEST_CRON=0 8 * * *
DIGEST_TIMEZONE=Asia/Kolkata
